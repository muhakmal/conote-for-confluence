    "marked": "^18.0.13",
    "mermaid": "^12.0.0",
    "puppeteer-core": "^25.11.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.9.1"
