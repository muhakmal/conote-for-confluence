{
  "name": "conote",
  "version": "0.1.0",
  "description": "Fast, local-first PRD & Markdown desktop notebook for Confluence Cloud.",
  "author": "Akmal Muhamad <muhamad.akmal@binus.ac.id>",
  "repository": {
    "type": "git",
    "url": "https://github.com/muhakmal/conote-for-confluence.git"
  },
  "homepage": "https://github.com/muhakmal/conote-for-confluence#readme",
  "type": "module",
  "main": "electron/main.js",
  "bin": {
    "conote": "bin/cn.js",
    "cn": "bin/cn.js"
  },
  "scripts": {
    "start": "node bin/cn.js serve",
    "dev": "electron electron/main.js",
    "electron": "electron electron/main.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mwl",
    "open": "node bin/cn.js open",
    "pull": "node bin/cn.js pull",
    "check": "node scripts/check-syntax.js",
    "test": "node scripts/run-tests.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13",
    "mermaid": "^12.0.0",
    "puppeteer-core": "^25.11.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}
